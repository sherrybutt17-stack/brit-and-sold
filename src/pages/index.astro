---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import robPortrait from '../assets/rob/rob-hero.png';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import Marquee from '../components/Marquee.astro';
import PageHero from '../components/PageHero.astro';
import ProcessStory from '../components/ProcessStory.astro';
import SplitText from '../components/SplitText.astro';
import { CTA } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { IconName } from '../lib/icons';
import { getPublicListings } from '../lib/listings';

const featured = getPublicListings()
  .filter((l) => l.status === 'active')
  .slice(0, 3);

const concerns: { icon: IconName; q: string; a: string }[] = [
  {
    icon: 'eye-off',
    q: 'Will people find out?',
    a: 'Your business is marketed without its name. Buyers are screened and sign a non-disclosure agreement before learning more, and you decide who hears what, and when.',
  },
  {
    icon: 'banknote',
    q: 'What is it actually worth?',
    a: 'Value depends on earnings, risk and how buyers in your industry think. We talk through what drives price for your business before anyone puts a number on it.',
  },
  {
    icon: 'briefcase',
    q: 'Will a sale distract from running it?',
    a: 'Keeping the business performing during a sale matters as much as the sale itself. The process is planned around your workload, so buyer questions don’t take over your week.',
  },
  {
    icon: 'clock',
    q: 'Is now the right time?',
    a: 'Sometimes yes, sometimes not yet. A first conversation is the quickest way to find out, and to learn what would make a later sale stronger.',
  },
  {
    icon: 'users',
    q: 'Will the buyer be any good?',
    a: 'Price matters, but so does fit. Buyers are asked about funding, experience and plans before they are introduced, so your time goes to serious people.',
  },
  {
    icon: 'list-checks',
    q: 'What do I need to prepare?',
    a: 'Very little to start. For a sale, buyers will want clean financials, documented processes and a business that doesn’t depend entirely on you.',
  },
];

const promises = [
  'A *quiet* first conversation',
  'No documents to start',
  'Company name *optional*',
  'Screened, serious buyers',
  'An NDA *before* any details',
  'No obligation to list',
];
---

<BaseLayout
  description="Thinking about selling your business? Build and Sold with Rob Dawson helps owners explore a sale discreetly and helps buyers find businesses for sale."
  stickyCta={CTA.sell}
>
  <PageHero variant="home">
    <div class="hero">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--pill load-in" style="--d: 0s">Business brokerage · with Rob Dawson</p>
        <SplitText
          as="h1"
          mode="load"
          class="hero__title"
          text="Thinking about selling your business? | Start with a *quiet conversation.*"
        />
        <p class="lead load-in" style="--d: 0.45s">
          Build and Sold helps owners explore a sale discreetly: understanding what buyers will look for, preparing
          properly, and meeting qualified buyers only when you’re ready.
        </p>
        <div class="btn-row load-in" style="--d: 0.6s">
          <a class="btn btn--on-dark btn--lg" href={CTA.sell.href} data-magnetic>
            {CTA.sell.label}
            <Icon name="arrow-right" class="icon--nudge" />
          </a>
          <a class="btn btn--ghost-dark btn--lg" href={CTA.browse.href}>{CTA.browse.label}</a>
        </div>
        <ul class="hero__assurances load-in" role="list" style="--d: 0.75s">
          <li><Icon name="check" />No documents needed to start</li>
          <li><Icon name="check" />Company name optional</li>
          <li><Icon name="check" />A conversation, not a commitment</li>
        </ul>
      </div>

      <aside class="first-call glass load-in" style="--d: 0.65s" aria-labelledby="first-call-title" data-spotlight>
        <p class="first-call__kicker">Your first conversation</p>
        <h2 id="first-call-title" class="first-call__title">What we’ll talk about</h2>
        <ol class="first-call__list" role="list">
          <li><span>01</span>What you want next, and whether a sale fits that plan.</li>
          <li><span>02</span>How buyers are likely to look at a business like yours.</li>
          <li><span>03</span>What would need to be true for a sale on terms you’d accept.</li>
          <li><span>04</span>Honest next steps, including “not yet” if that’s the right answer.</li>
        </ol>
        <a class="text-link" href={url('/sell#process')}>See how a sale works <Icon name="arrow-right" /></a>
      </aside>
    </div>
    <a class="scroll-cue hero__cue load-in" style="--d: 1.1s" href="#paths">
      Scroll <span class="scroll-cue__line" aria-hidden="true"></span>
    </a>
  </PageHero>

  <section class="lift promise-band" aria-label="What to expect">
    <Marquee label="What to expect" items={promises} />
  </section>

  <!-- Two paths -->
  <section class="section section--tight paths" id="paths" aria-label="Choose your path">
    <div class="container paths__grid">
      <article class="path path--owner" data-reveal data-spotlight>
        <span class="path__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        <p class="path__kicker">For business owners</p>
        <h2 class="path__title">Thinking about <em>selling?</em></h2>
        <p>
          Whether you’re ready now or planning a few years out, start by understanding your options. You decide what is
          shared, and when.
        </p>
        <a class="btn btn--on-dark path__cta" href={CTA.sell.href}>
          {CTA.sell.label}
          <Icon name="arrow-right" class="icon--nudge" />
        </a>
      </article>
      <article class="path path--buyer" data-reveal data-spotlight style="--reveal-delay: 1">
        <span class="path__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        <p class="path__kicker">For buyers</p>
        <h2 class="path__title">Looking to <em>buy</em> a business?</h2>
        <p>
          Browse businesses for sale, then request details. Qualified buyers receive the full information package after
          signing a confidentiality agreement.
        </p>
        <a class="btn path__cta" href={CTA.browse.href}>
          {CTA.browse.label}
          <Icon name="arrow-right" class="icon--nudge" />
        </a>
      </article>
    </div>
  </section>

  <!-- 01 Concerns -->
  <section class="section section--mist" aria-labelledby="concerns-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">01</span>Before you decide</p>
          <SplitText id="concerns-title" text="The questions owners ask *before* they say “sell” out loud." />
        </div>
        <p class="lead" data-reveal style="--reveal-delay: 2">
          Most owners only sell once. It’s normal to have doubts. Here is how a careful process handles the common ones.
        </p>
      </div>
      <ul class="concerns" role="list">
        {
          concerns.map((c, i) => (
            <li class="concern" data-reveal data-spotlight style={`--reveal-delay: ${i % 3}`}>
              <span class="concern__icon">
                <Icon name={c.icon} />
              </span>
              <h3>{c.q}</h3>
              <p class="small muted">{c.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 02 Process -->
  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">02</span>How it works</p>
          <SplitText id="process-title" text="A clear process, from *first call* to closing." />
        </div>
        <p class="lead" data-reveal style="--reveal-delay: 2">
          Every sale is different, but the shape is predictable. You’ll always know what happens next.
        </p>
      </div>
      <ProcessStory />
      <a class="text-link process-link" href={url('/sell#process')}>See the full process <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- 03 Listings -->
  <section class="section section--sky" aria-labelledby="listings-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__num">03</span>Businesses for sale</p>
          <SplitText id="listings-title" text="Recently *listed*" />
        </div>
        <p class="lead" data-reveal style="--reveal-delay: 2">
          A preview of the directory. Every listing shown here is a fictional sample for demonstration.
        </p>
      </div>
      <ul class="featured" role="list">
        {
          featured.map((listing, i) => (
            <li data-reveal style={`--reveal-delay: ${i}`}>
              <ListingCard listing={listing} />
            </li>
          ))
        }
      </ul>
      <div class="featured__more">
        <a class="btn btn--secondary" href={CTA.browse.href}>
          Browse all businesses
          <Icon name="arrow-right" class="icon--nudge" />
        </a>
      </div>
    </div>
  </section>

  <!-- 04 Meet Rob -->
  <section class="section meet" aria-labelledby="meet-title">
    <div class="container meet__inner">
      <div class="meet__media" data-reveal>
        <div class="meet__frame" aria-hidden="true"></div>
        <div class="meet__photo" data-parallax="0.06">
          <Picture
            src={robPortrait}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[282, 420, 564]}
            sizes="(min-width: 64rem) 420px, (min-width: 40rem) 60vw, 85vw"
            alt="Rob Dawson, smiling, in a navy suit and white shirt."
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="meet__copy">
        <p class="eyebrow" data-reveal><span class="eyebrow__num">04</span>Who you’ll talk to</p>
        <SplitText id="meet-title" text="Meet *Rob Dawson*" />
        <p class="lead" data-reveal style="--reveal-delay: 1">
          Rob is an entrepreneur, CEO and business coach with more than 12 years in digital-marketing consulting. He
          knows what it takes to build a business, and how much of an owner’s life goes into one.
        </p>
        <a class="text-link" href={url('/about')} data-reveal style="--reveal-delay: 3">More about Rob <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Before you need to sell"
    title="The best time to prepare for a sale is *before you need one.*"
    primary={CTA.sell}
    secondary={{ href: url('/sell#readiness'), label: 'What buyers will ask about' }}
  >
    <p>
      Buyers and lenders usually ask for the last few years of financial statements and tax returns. Improvements you
      make now, such as cleaner books, less reliance on you and documented systems, take time to show up in those
      numbers.
    </p>
    <p>Starting the conversation early gives you more options, not fewer.</p>
  </CtaBand>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
      align-items: center;
      gap: var(--space-8);
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .hero__copy .eyebrow {
    margin-bottom: 0;
  }
  .hero__copy :global(.hero__title) {
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.4rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__copy :global(.hero__title em) {
    color: var(--sky-300);
  }
  .hero__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }
  .hero__assurances li {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
  }
  .hero__assurances .icon {
    color: var(--sky-300);
  }
  .hero__cue {
    display: none;
    text-decoration: none;
  }
  @media (min-width: 64rem) and (min-height: 46rem) {
    .hero__cue {
      position: absolute;
      bottom: calc(var(--lift) + 2rem);
      left: 50%;
      display: inline-flex;
      flex-direction: column;
      translate: -50% 0;
    }
  }

  .first-call {
    --spot-color: rgb(140 190 255 / 0.12);
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .first-call__kicker {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sky-300);
  }
  .first-call__title {
    font-size: clamp(1.6rem, 1.4rem + 0.8vw, 2.1rem);
  }
  .first-call__list {
    width: 100%;
  }
  .first-call__list li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid rgb(156 195 255 / 0.16);
    color: var(--on-dark);
  }
  .first-call__list span {
    font-family: var(--font-display-stack);
    color: var(--sky-300);
  }

  /* Marquee band */
  .promise-band {
    padding-block: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  /* Two paths */
  .paths__grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .paths__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .path {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    min-height: 22rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3.25rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s ease;
  }
  .path:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  /* The button is the link; its hit area covers the whole card. */
  .path__cta {
    position: static;
    margin-top: auto;
  }
  .path__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .path--owner {
    --spot-color: rgb(255 255 255 / 0.14);
    background:
      radial-gradient(120% 120% at 100% 0%, rgb(58 139 255 / 0.55), transparent 55%),
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px) -1px -1px / 40px 40px,
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px) -1px -1px / 40px 40px,
      var(--cobalt-600);
    color: var(--white);
  }
  .path--owner .path__title {
    color: var(--white);
  }
  .path--owner .path__kicker {
    color: var(--sky-200);
  }
  .path--owner :focus-visible {
    outline-color: var(--white);
  }
  .path--owner .btn:focus-visible {
    box-shadow: 0 0 0 3px var(--cobalt-600), 0 0 0 5px var(--white);
  }
  .path--buyer {
    border: 1px solid var(--line);
    background: var(--white);
  }
  .path__kicker,
  .path__title {
    padding-right: 3.75rem;
  }
  .path__kicker {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cobalt-600);
  }
  .path__title {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .path--buyer .path__title em {
    color: var(--cobalt-600);
  }
  .path p:not(.path__kicker) {
    max-width: 34rem;
  }
  .path__arrow {
    position: absolute;
    top: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    right: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.5;
    transition:
      transform 0.6s var(--ease-spring),
      opacity 0.4s ease;
  }
  .path:hover .path__arrow {
    opacity: 1;
    transform: rotate(45deg);
  }

  /* Concerns */
  .concerns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
  }
  .concern {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--white);
  }
  .concern__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--sky-100);
    color: var(--cobalt-600);
    transition:
      transform 0.6s var(--ease-spring),
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .concern:hover .concern__icon {
    background: var(--cobalt-600);
    color: var(--white);
    transform: rotate(-8deg) scale(1.08);
  }
  .concern h3 {
    font-size: 1.35rem;
  }

  .process-link {
    margin-top: var(--space-6);
  }

  /* Featured listings: a swipeable row on phones, a grid above that. */
  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 47.99rem) {
    .featured {
      grid-template-columns: none;
      grid-auto-columns: 86%;
      grid-auto-flow: column;
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-2) var(--gutter) var(--space-4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--gutter);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .featured > li {
      scroll-snap-align: start;
    }
    /* Cards off to the side of the swipe row never scroll into view vertically; skip the reveal. */
    .featured > :global(li.reveal-pending) {
      opacity: 1;
      transform: none;
    }
  }
  .featured__more {
    margin-top: var(--space-6);
  }

  /* Meet Rob */
  .meet__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .meet__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
    }
  }
  .meet__media {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    padding-top: var(--space-6);
  }
  .meet__frame {
    position: absolute;
    inset: 22% 4% 0;
    z-index: -1;
    overflow: hidden;
    border: 1px solid var(--sky-200);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 70% at 50% 100%, rgb(58 107 232 / 0.28), transparent 70%),
      linear-gradient(var(--sky-200) 1px, transparent 1px) -1px -1px / 32px 32px,
      linear-gradient(90deg, var(--sky-200) 1px, transparent 1px) -1px -1px / 32px 32px,
      var(--sky-100);
  }
  .meet__photo {
    width: min(100%, 420px);
  }
  .meet__photo :global(img) {
    width: 100%;
    aspect-ratio: 564 / 701;
    object-fit: contain;
    object-position: bottom;
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
  }
  .meet__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .meet__copy .eyebrow {
    margin-bottom: 0;
  }
  .meet__copy :global(h2 em) {
    color: var(--cobalt-600);
  }
</style>
