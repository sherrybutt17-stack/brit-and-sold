---
import { url } from '../../lib/url';
import { BRAND } from '../../config/site';
import type { GetStaticPaths } from 'astro';
import Icon from '../../components/Icon.astro';
import ListingCard from '../../components/ListingCard.astro';
import PageHero from '../../components/PageHero.astro';
import RequestDetailsDialog from '../../components/RequestDetailsDialog.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { industryIcon } from '../../lib/industries';
import {
  EARNINGS_LABELS,
  formatEmployees,
  formatListedDate,
  formatUSD,
  getPublicListings,
  type PublicListing,
} from '../../lib/listings';

export const getStaticPaths = (() => {
  const listings = getPublicListings();
  return listings.map((listing) => ({ params: { slug: listing.slug }, props: { listing, all: listings } }));
}) satisfies GetStaticPaths;

interface Props {
  listing: PublicListing;
  all: PublicListing[];
}

const { listing, all } = Astro.props;
const isSold = listing.status === 'sold';
const hasAcceptedOffer = listing.status === 'under-loi' || listing.status === 'under-contract';
const related = [
  ...all.filter((l) => l.id !== listing.id && l.industry === listing.industry),
  ...all.filter((l) => l.id !== listing.id && l.industry !== listing.industry && l.status === 'active'),
].slice(0, 3);

// `count` makes the figure count up when it scrolls into view (see scripts/motion.ts).
type Metric = { label: string; value: string; count?: number; format?: 'usd' | 'int' };
const metrics = [
  { label: 'Annual revenue', value: formatUSD(listing.revenue), count: listing.revenue, format: 'usd' },
  listing.earnings && {
    label: EARNINGS_LABELS[listing.earnings.kind],
    value: formatUSD(listing.earnings.amount),
    count: listing.earnings.amount,
    format: 'usd',
  },
  listing.askingPrice === null
    ? { label: 'Asking price', value: 'On request' }
    : {
        label: isSold ? 'Last asking price' : 'Asking price',
        value: formatUSD(listing.askingPrice),
        count: listing.askingPrice,
        format: 'usd',
      },
  { label: 'Employees', value: formatEmployees(listing.employees) },
  listing.yearsOperating && {
    label: 'Years operating',
    value: String(listing.yearsOperating),
    count: listing.yearsOperating,
    format: 'int',
  },
].filter(Boolean) as Metric[];

const gated = [
  listing.addressVisibility === 'exact' ? 'Business name' : 'Business name and exact location',
  'Three years of financial statements',
  'Customer, staff and supplier overview',
  'Lease, equipment and asset details',
  'Reason for sale and transition plans',
];
---

<BaseLayout
  title={`${listing.isSample ? 'Sample: ' : ''}${listing.title}`}
  shortBrand
  description={`${listing.isSample ? 'Fictional sample: ' : ''}${listing.title}. ${listing.placeLabel}; ${formatUSD(listing.revenue)} annual revenue. ${isSold ? 'This business has been sold.' : `Request details confidentially through ${BRAND.short}.`}`}
>
  <PageHero class="listing-hero">
    <nav aria-label="Breadcrumb" class="breadcrumb load-in" style="--d: 0s">
      <ol role="list">
        <li><a href={url('/businesses')}>Browse Businesses</a></li>
        <li aria-current="page">{listing.title}</li>
      </ol>
    </nav>

    <div class="listing-hero__top">
      <div>
        <div class="listing-hero__badges load-in" style="--d: 0.1s">
          {listing.isSample && <span class="badge badge--sample">Sample listing</span>}
          <StatusBadge status={listing.status} />
        </div>
        <p class="eyebrow listing-hero__industry load-in" style="--d: 0.15s">{listing.industry}</p>
        <h1 style={`view-transition-name: listing-${listing.id}`}>{listing.title}</h1>
        <p class="listing-hero__meta load-in" style="--d: 0.3s">
          <span><Icon name="map-pin" />{listing.locationLabel}</span>
          <span><Icon name="calendar" />Listed {formatListedDate(listing.listedAt)}</span>
        </p>
      </div>
      <span class="listing-hero__mark load-in" style="--d: 0.2s" aria-hidden="true">
        <Icon name={industryIcon(listing.industry)} />
      </span>
    </div>

    <dl class="metrics load-in" style={`--d: 0.4s; --metric-count: ${metrics.length}`}>
      {
        metrics.map((m) => (
          <div class="metric glass" data-spotlight>
            <dt>{m.label}</dt>
            <dd class:list={{ 'metric__text': m.count === undefined && !/\d/.test(m.value) }} data-count={m.count} data-count-format={m.format}>
              {m.value}
            </dd>
          </div>
        ))
      }
    </dl>
    {
      listing.isSample && (
        <p class="xs listing-hero__sample">Fictional sample for demonstration. These figures do not describe a real business.</p>
      )
    }
  </PageHero>

  <section class="section section--tight lift">
    <div class="container listing-body">
      <div class="listing-main">
        <section aria-labelledby="overview-title">
          <h2 id="overview-title">Overview</h2>
          <p class="lead">{listing.overview}</p>
        </section>

        {
          listing.strengths.length > 0 && (
            <section aria-labelledby="strengths-title">
              <h2 id="strengths-title">Key strengths</h2>
              <ul role="list" class="check-list">
                {listing.strengths.map((s) => (
                  <li>
                    <Icon name="check" />
                    {s}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          listing.growthOpportunities.length > 0 && (
            <section aria-labelledby="growth-title">
              <h2 id="growth-title">Growth opportunities</h2>
              <ul role="list" class="check-list check-list--growth">
                {listing.growthOpportunities.map((g) => (
                  <li>
                    <Icon name="trending-up" />
                    {g}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <aside class="notice confidentiality" aria-label="Confidentiality notice">
          <Icon name="eye-off" />
          <p>
            <strong>Confidentiality notice.</strong> Information in this listing comes from the seller and has not been
            independently verified. Please don’t contact the business, its owner, staff, customers or suppliers directly.
            All inquiries go through {BRAND.short}.
          </p>
        </aside>
      </div>

      <aside class="listing-side" aria-labelledby="interest-title">
        <div class="interest card" data-spotlight>
          <h2 id="interest-title" class="interest__title">
            {isSold ? 'This business has been sold' : 'Interested in this business?'}
          </h2>
          {
            isSold ? (
              <p class="small muted">It stays here as an example of a completed listing. Browse current opportunities instead.</p>
            ) : (
              <p class="small muted">
                {hasAcceptedOffer
                  ? 'The seller has accepted an offer. You can still register interest in case it does not proceed.'
                  : 'Answer a few qualification questions and agree to confidentiality. Qualified buyers then receive the full information package.'}
              </p>
            )
          }
          {
            isSold ? (
              <a class="btn btn--block btn--lg" href={url('/businesses')}>
                Browse current businesses
                <Icon name="arrow-right" class="icon--nudge" />
              </a>
            ) : (
              <button type="button" class="btn btn--block btn--lg" data-open-request data-magnetic>
                {hasAcceptedOffer ? 'Register interest' : 'Request details'}
                <Icon name="arrow-right" class="icon--nudge" />
              </button>
            )
          }

          {
            !isSold && (
              <div class="locked">
                <p class="locked__title"><Icon name="lock" /> Shared after signing an NDA</p>
                <ul role="list">
                  {gated.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--mist" aria-labelledby="related-title">
        <div class="container">
          <div class="related-head">
            <h2 id="related-title">More sample listings</h2>
            <a class="text-link" href={url('/businesses')}>
              Browse all <Icon name="arrow-right" />
            </a>
          </div>
          <ul role="list" class="related-grid">
            {related.map((l) => (
              <li>
                <ListingCard listing={l} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {!isSold && <RequestDetailsDialog listingTitle={listing.title} heading={hasAcceptedOffer ? 'Register interest' : 'Request details'} />}
</BaseLayout>

<style>
  /* One line: the current page name truncates only when it runs out of room. */
  .breadcrumb ol {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: rgb(156 195 255 / 0.4);
  }
  .breadcrumb li {
    flex: none;
  }
  .breadcrumb [aria-current] {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .listing-hero__top {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    justify-content: space-between;
  }
  .listing-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .listing-hero__industry {
    margin-bottom: var(--space-3);
  }
  .listing-hero__top h1 {
    max-width: 20ch;
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .listing-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    color: var(--on-dark-muted);
  }
  .listing-hero__meta span {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }
  .listing-hero__meta .icon {
    color: var(--sky-300);
  }
  .listing-hero__mark {
    display: none;
  }
  @media (min-width: 48rem) {
    .listing-hero__mark {
      display: grid;
      flex: none;
      place-items: center;
      width: 7rem;
      height: 7rem;
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      background: radial-gradient(circle at 30% 20%, rgb(58 139 255 / 0.35), transparent 70%), rgb(255 255 255 / 0.04);
      color: var(--sky-300);
    }
    .listing-hero__mark .icon {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  /* An odd tile out on mobile spans the row instead of sitting alone in a half-width slot. */
  .metric:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .metrics {
      grid-template-columns: repeat(var(--metric-count, 5), minmax(0, 1fr));
    }
    .metric:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
  .metric {
    --spot-color: rgb(140 190 255 / 0.14);
    display: flex;
    flex-direction: column;
    padding: var(--space-4) clamp(1rem, 0.5rem + 1vw, 1.5rem);
    border-radius: var(--radius);
  }
  .metric dt {
    font-size: var(--fs-xs);
    color: var(--on-dark-muted);
  }
  /* Values sit on a shared baseline even when a label wraps to more lines than its neighbours. */
  .metric dd {
    margin-top: auto;
    padding-top: var(--space-1);
    font-family: var(--font-display-stack);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 500;
    white-space: nowrap;
    color: var(--white);
  }
  .metric dd.metric__text {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
  }
  /* Five narrow tiles on tablets: a smaller figure keeps values like "$2.85M" on one line. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .metric dd {
      font-size: 1.45rem;
    }
    .metric dd.metric__text {
      font-size: 1.15rem;
    }
  }
  .listing-hero__sample {
    margin-top: var(--space-4);
    color: var(--on-dark-muted);
  }

  .listing-body {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 64rem) {
    .listing-body {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: var(--space-8);
      align-items: start;
    }
    .listing-side {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .listing-main {
    display: grid;
    gap: var(--space-7);
  }
  .listing-main h2 {
    margin-bottom: var(--space-4);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .listing-main .lead {
    color: var(--ink);
  }
  .check-list {
    display: grid;
    gap: var(--space-3);
  }
  .check-list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .check-list .icon {
    margin-top: 0.25rem;
    color: var(--green-700);
  }
  .check-list--growth .icon {
    color: var(--cobalt-600);
  }

  .interest {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    box-shadow: var(--shadow);
  }
  .interest__title {
    font-size: 1.5rem;
  }
  .locked {
    margin-top: var(--space-2);
    padding: var(--space-4);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--mist);
  }
  .locked__title {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--navy-900);
  }
  .locked__title .icon {
    color: var(--cobalt-600);
  }
  .locked ul {
    display: grid;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .locked li {
    position: relative;
    padding-left: 1.1rem;
  }
  .locked li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .related-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }
  /* One column on phones, two cards on tablets, three on desktop: never a lone card on its own row. */
  .related-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .related-grid > li:nth-child(n + 3) {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .related-grid > li:nth-child(n + 3) {
      display: block;
    }
  }
</style>
