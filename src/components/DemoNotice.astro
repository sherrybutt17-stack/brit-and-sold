---
import Icon from './Icon.astro';
import { IS_DEMO } from '../config/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

{
  IS_DEMO && (
    <div class="notice notice--warn demo-notice" role="note">
      <Icon name="info" />
      <p>
        <strong>{title}</strong> <slot />
      </p>
    </div>
  )
}
