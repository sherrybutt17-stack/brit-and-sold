---
import { url } from '../lib/url';
import { CTA, NAV } from '../config/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';

const trim = (p: string) => p.replace(/\/$/, '') || '/';
const path = trim(Astro.url.pathname);
const home = trim(url('/'));
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__brand" aria-current={path === home ? 'page' : undefined}>
      <Wordmark />
      <span class="visually-hidden">, home</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--sm site-header__cta" href={CTA.sell.href} data-magnetic>{CTA.sell.label}</a>

    <button
      class="menu-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <Icon name="menu" />
      <span>Menu</span>
    </button>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu on-dark" aria-label="Site menu" data-lenis-prevent>
  <div class="mobile-menu__head">
    <Wordmark tone="light" />
    <button class="mobile-menu__close" type="button" data-menu-close>
      <Icon name="x" />
      <span class="visually-hidden">Close menu</span>
    </button>
  </div>
  <nav aria-label="Mobile">
    <ul role="list" class="mobile-menu__links">
      <li><a href={url('/')} aria-current={path === home ? 'page' : undefined}>Home</a></li>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a class="btn btn--on-dark btn--block" href={CTA.sell.href}>
      {CTA.sell.label}
      <Icon name="arrow-right" class="icon--nudge" />
    </a>
    <p class="xs">A first conversation is private and carries no obligation.</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (dialog && openBtn) {
    const setExpanded = (open: boolean) => openBtn.setAttribute('aria-expanded', String(open));

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
    });
    dialog.addEventListener('close', () => setExpanded(false));
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    // Close on backdrop click and when following a link.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest('a')) dialog.close();
    });
    // The menu is only for small screens; close it if the viewport grows.
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.9);
    color: var(--navy-900);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.5s var(--ease-out-expo);
  }
  .site-header.is-scrolled {
    box-shadow: 0 10px 30px -18px rgb(10 26 51 / 0.35);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  /* Over a dark hero, before scrolling: transparent with light text. */
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) {
    --wordmark-accent: var(--sky-300);
    border-color: transparent;
    background: transparent;
    color: var(--white);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-nav a {
    color: rgb(255 255 255 / 0.86);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-nav a:hover,
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-nav a[aria-current='page'] {
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-nav a[aria-current='page']::after {
    background: var(--sky-300);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-header__cta {
    --btn-bg: var(--white);
    --btn-fg: var(--navy-900);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .site-header__cta:hover {
    --btn-bg: var(--sky-100);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) .menu-toggle {
    border-color: rgb(156 195 255 / 0.4);
    background: rgb(255 255 255 / 0.04);
    color: var(--white);
  }
  :global(.js:has(main > .page-hero:first-child)) .site-header:not(.is-scrolled) :focus-visible {
    outline-color: var(--sky-300);
  }
  .site-header__brand {
    color: inherit;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
  }
  .site-header__brand {
    margin-right: auto;
    text-decoration: none;
  }
  .site-header__cta:hover {
    --btn-bg: var(--cobalt-700);
    --btn-fg: var(--white);
  }
  .site-nav ul {
    display: flex;
    gap: var(--space-1);
  }
  .site-nav a {
    position: relative;
    display: block;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    color: var(--ink);
    transition:
      background-color var(--dur-fast) ease,
      color 0.4s ease;
    font-size: 0.975rem;
    font-weight: 500;
    text-decoration: none;
  }
  .site-nav a:hover {
    background: var(--sky-50);
    color: var(--cobalt-700);
  }
  .site-nav a[aria-current='page'] {
    color: var(--navy-900);
    font-weight: 600;
  }
  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    width: 0.3rem;
    height: 0.3rem;
    margin-left: -0.15rem;
    border-radius: 50%;
    background: var(--cobalt-600);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy-900);
    font-size: var(--fs-small);
    font-weight: 600;
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      color 0.4s ease;
  }
  .menu-toggle:hover {
    border-color: var(--cobalt-600);
  }

  @media (max-width: 63.99rem) {
    .site-nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 39.99rem) {
    .site-header__cta {
      display: none;
    }
  }

  /* Mobile menu: a modal sheet from the right; full width on phones so no sliver of page shows beside it. */
  .mobile-menu {
    width: 24rem;
    max-width: 100%;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--navy-900);
    color: var(--on-dark);
  }
  @media (max-width: 29.99rem) {
    .mobile-menu {
      width: 100%;
    }
  }
  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu::backdrop {
    background: rgb(7 18 38 / 0.55);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      transition:
        transform 320ms var(--ease-out),
        overlay 320ms allow-discrete,
        display 320ms allow-discrete;
      transform: translateX(100%);
    }
    .mobile-menu[open] {
      transform: none;
    }
    @starting-style {
      .mobile-menu[open] {
        transform: translateX(100%);
      }
    }
  }
  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    border-bottom: 1px solid rgb(156 195 255 / 0.18);
  }
  .mobile-menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid rgb(156 195 255 / 0.35);
    border-radius: 50%;
    background: transparent;
    color: var(--white);
  }
  .mobile-menu__links {
    padding: var(--space-5) var(--gutter);
  }
  .mobile-menu__links a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(156 195 255 / 0.14);
    color: var(--white);
    font-family: var(--font-display-stack);
    font-size: 1.65rem;
    text-decoration: none;
  }
  .mobile-menu__links a[aria-current='page'] {
    color: var(--sky-300);
  }
  .mobile-menu__foot {
    display: grid;
    gap: var(--space-3);
    margin-top: auto;
    padding: var(--space-5) var(--gutter) var(--space-6);
    color: var(--on-dark-muted);
  }
</style>
