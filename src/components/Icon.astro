---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  /** Accessible label. Omit for decorative icons (the default). */
  label?: string;
  class?: string;
  [attr: string]: unknown;
}

// `rest` carries the parent's scoped-style attribute, so parent CSS like `.card .icon` applies.
const { name, label, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
